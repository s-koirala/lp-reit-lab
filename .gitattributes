# =====================================================================
# Text/binary classification + nbstripout filter for Jupyter notebooks
# =====================================================================

# Auto-detect text files and normalize line endings
* text=auto

# Force LF for these (cross-platform tooling)
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.cfg text eol=lf

# Web front-end source (added P1): keep LF despite Windows core.autocrlf, so
# Prettier (endOfLine: lf) is satisfied on every checkout.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf

# Notebook stripping via nbstripout (pre-commit hook runs on save)
*.ipynb filter=nbstripout
*.ipynb diff=ipynb

# Binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.parquet binary
*.feather binary
*.h5 binary
*.hdf5 binary
*.npy binary
*.npz binary
*.pt binary
*.onnx binary
*.joblib binary
*.pkl binary
*.xlsx binary
*.docx binary
*.pptx binary

# H002 freeze-evidence data files: byte-stable working copies (their sha256s are
# frozen in data/_manifest.json; autocrlf rewriting would drift the checksums)
data/interim/*.csv text eol=lf
data/interim/*.parquet binary
